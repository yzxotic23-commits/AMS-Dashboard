# ── Demo mode — set true untuk preview layout dengan data dummy (tanpa Supabase)
VITE_DEMO_MODE=false

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (for npm run migrate:supabase)
# Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Default master admin (opsional dev shortcut: npm run create:admin) ───────

# ── API Server ────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── WSAF Engine bridge (FeedFlow desktop API) ─────────────────────────────
WSAF_BRIDGE_URL=http://127.0.0.1:47821
# Auto-launch FeedFlow engine when AMS API starts (single terminal: npm run dev)
WSAF_AUTO_START=true
# Optional override if WSAF folder is not ../WSAF relative to AMS Project
# WSAF_ROOT=/absolute/path/to/WSAF

# ── Web (Vite) ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WSAF_BRIDGE_URL=http://127.0.0.1:47821
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
