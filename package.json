{
  "name": "ams-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Account Management System — unified AMS + FeedFlow command center",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:all": "npm run dev",
    "build": "npm run build -w apps/web",
    "start:api": "npm run start -w apps/api",
    "setup:supabase": "node scripts/setup-supabase.js",
    "migrate:supabase": "node scripts/run-migration.js",
    "migrate:screenshots": "node scripts/migrate-screenshot-bucket.js",
    "migrate:username": "node scripts/run-username-migration.js",
    "seed:sample": "node scripts/seed-sample-data.js",
    "prune:device-slots": "node scripts/prune-device-slot-overflow.js",
    "prune:device-slots:apply": "node scripts/prune-device-slot-overflow.js --apply",
    "fix:device-channels": "node scripts/fix-device-slot-channels.js",
    "fix:device-channels:apply": "node scripts/fix-device-slot-channels.js --apply",
    "seed:align-demo": "node scripts/seed-align-demo.js",
    "clear:data": "node scripts/clear-operational-data.js",
    "seed:devices": "node scripts/seed-devices.js",
    "renumber:devices": "node scripts/renumber-device-codes.js",
    "create:admin": "node scripts/create-admin-user.js",
    "seed:operators": "node scripts/seed-operator-users.js",
    "test:activation": "node scripts/test-activation-flow.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pg": "^8.22.0"
  }
}
